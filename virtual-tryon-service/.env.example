SERVICE_NAME=virtual-tryon-service
SERVICE_PORT=8092
DEBUG=false
ENV=development

MODEL_NAME=catvton
MODEL_VERSION=1.0.0
MODEL_PATH=zhengchong/CatVTON
DEVICE=cuda
DTYPE=float16

IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
MAX_ATTEMPTS=2
QUALITY_THRESHOLD=0.85

STORAGE_TYPE=local
STORAGE_BUCKET=fashionpin-media
STORAGE_DIRECTORY=./storage/media
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REQUESTED=fashionpin.vton.requested.v1
KAFKA_TOPIC_COMPLETED=fashionpin.vton.completed.v1
KAFKA_TOPIC_FAILED=fashionpin.vton.failed.v1
KAFKA_GROUP_ID=virtual-tryon-service

TEMP_DIRECTORY=/tmp/vton
